# The ResiResi reservation API. It is an open origin — no key required.
RESIRESI_API_URL=https://backend.resiresi.com

# --- Study fixture: fills the "Technical implementation details" guide with the
# --- exact connection commands, so nothing is left for the tester to guess.
RESIRESI_EC2_HOST=          # e.g. ec2-1-2-3-4.compute-1.amazonaws.com (from the AWS console)
RESIRESI_EC2_USER=ubuntu    # "ec2-user" on Amazon Linux AMIs
RESIRESI_EC2_KEY=resiresi.pem
RESIRESI_REPO_DIR=/home/ubuntu/code/rr/resiresi-frontend
RESIRESI_PROXY_NAME=resiresi

# --- Only needed once the tester adds the widgets (Part B). Server-only. ---
# APIBLAZE_CP_KEY=
