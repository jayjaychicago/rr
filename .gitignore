# --- study protection: never track or clean these ---
.vercel/
.env*.local
*.env.production.local
# Dependencies are installed per-clone (npm install), never committed —
# committed node_modules ship platform-specific binaries that break other OSes.
node_modules/
*.tsbuildinfo

# Next.js build output — generated by `npm run build`, never committed.
.next/
out/

# guided lab per-run state
lab/.state.json
