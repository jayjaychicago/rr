# --- study protection: never track or clean these ---
.vercel/
.env*.local
*.env.production.local
# Dependencies are installed per-clone (npm install), never committed —
# committed node_modules ship platform-specific binaries that break other OSes.
node_modules/
*.tsbuildinfo

# Next.js build output — generated by `npm run build`, never committed.
.next/
out/

# guided lab per-run state
lab/.state.json
lab/.tunnel.log

# Generated by the lab's wire step (lab/wire.mjs) — never commit; each run
# writes its own (the tenant suffix inside is per-run).
resiresi-frontend/lib/apiblaze-user.ts
resiresi-frontend/app/api/apiblaze/
